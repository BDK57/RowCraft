{
  "name": "rowcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Personalize editable Illustrator artwork from spreadsheet rows.",
  "author": "RowCraft",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --win --x64 --dir --publish never",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder --win --x64 --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "multer": "^2.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "shadcn": "^4.23.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
